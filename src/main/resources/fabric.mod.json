  "authors": ["Shocky"],
  "license": "MIT",
  "icon": "assets/shockysspotifyhud/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.shocky.spotifyhud.ShockysSpotifyHud"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
